@mixin Timestamps {
	created_at: sql"TIMESTAMP";
};
table Users {
	@mixin Timestamps;
	uid @primary_key;
};
table Posts {
	author: id ~ Users(uid);
	editor: user_id @policy.for(User) "own" (_ == current_setting("app.uid")::id);
