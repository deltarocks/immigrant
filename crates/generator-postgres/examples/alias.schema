!!!RESULT
-- updated: aliases resolve to definitions --
CREATE ROLE "user";
CREATE DOMAIN user_id AS INTEGER;
CREATE TABLE users (
	uid user_id NOT NULL
,	created_at TIMESTAMP NOT NULL
,	CONSTRAINT users_uid_pkey PRIMARY KEY(uid)
);
GRANT SELECT ON users TO "user";
CREATE TABLE posts (
	author user_id NOT NULL
,	editor user_id NOT NULL
);
ALTER TABLE posts ENABLE ROW LEVEL SECURITY;
GRANT INSERT ON posts TO "user";
CREATE POLICY own ON posts FOR ALL TO "user" USING (editor = (current_setting('app.uid'))::user_id);
CREATE VIEW account_views WITH (security_invoker = true) AS SELECT uid FROM users;
GRANT SELECT ON account_views TO "user";
ALTER TABLE posts ADD CONSTRAINT posts_author_fk FOREIGN KEY(author) REFERENCES users(uid);
