!!!TEST aliases resolve to definitions
scalar user_id = sql"INTEGER";
role User {
	default {
		select;
	};
};
@mixin Timestamps {
	created_at: sql"TIMESTAMP";
};
alias uid = user_id;
alias Person = User;
alias Stamped = Timestamps;
alias Account = Users;
table Users {
	@mixin Stamped;
	uid @primary_key;
};
table Posts {
	author: uid ~ Account(uid);
	editor: uid @policy.for(Person) "own" (_ == current_setting("app.uid")::uid);
	@role Person {
		insert;
	};
	@rls;
};
view AccountView = sql"SELECT {Account.uid} FROM {Account}";
