!!!SETUP
scalar user_id = sql"INTEGER";
!!!TEST
role User {
	default {
		select;
	};
};

table Name {
	user_id;
};
table Aaa {
	user_id @policy.for(User) "per-user" (_ == current_setting("app.current_user_id")::user_id);

	@role User {
		insert;
	};
	@rls;
};
