!!!TEST initial
scalar id = sql"INTEGER";
enum Status {
	active;
	disabled;
};
struct Point {
	x: id;
	y: id;
};
table User {
	id @primary_key;
	mail: sql"TEXT";
	first: sql"TEXT";
	second: sql"TEXT";
	status: Status;
	pos: Point;
};
!!!UPDATE rename table, column, variant and field, code and db names at once
scalar id = sql"INTEGER";
enum Status {
	active;
	inactive;
	@renamed disabled to inactive;
};
struct Point {
	lat: id;
	y: id;
	@renamed x to lat;
};
table Account {
	id @primary_key;
	email: sql"TEXT";
	first: sql"TEXT";
	second: sql"TEXT";
	status: Status;
	pos: Point;
	@renamed mail to email;
};
@renamed User to Account;
!!!UPDATE stale hints are ignored
