-- updated: plugins referencing each other --
CREATE DOMAIN user_id AS INTEGER;
CREATE DOMAIN page_id AS INTEGER;
CREATE TABLE users (
	id user_id NOT NULL
,	home page_id NOT NULL
,	CONSTRAINT users_id_pkey PRIMARY KEY(id)
);
CREATE TABLE pages (
	id page_id NOT NULL
,	owner user_id NOT NULL
,	CONSTRAINT pages_id_pkey PRIMARY KEY(id)
);
ALTER TABLE users ADD CONSTRAINT users_home_fk FOREIGN KEY(home) REFERENCES pages(id);
